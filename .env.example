# Copy to .env and fill in. `npm start` loads it automatically.

# Bot → Token, in the Discord Developer Portal. Secret: never commit the real one.
DISCORD_TOKEN=

# General Information → Application ID.
DISCORD_CLIENT_ID=

# Required. Discord user ids of whoever runs this bot, comma-separated. They are
# the only ones who can use /guilds, and they are who gets DMed when the bot is
# added to a server that is not on the allowlist.
OWNER_IDS=

# The allowlist: server ids the bot is licensed to run in, comma-separated.
# Anything else is reported to OWNER_IDS and, by default, left immediately.
# An empty list approves nothing — it does not approve everything.
#
# This is the permanent half of the list. /guilds approve adds to the data file
# instead, so this stays the record of what was set up deliberately.
APPROVED_GUILDS=

# Optional. What happens in a server that is not approved:
#   leave  — report it and leave immediately (default)
#   report — report it, stay, but block every command there
UNAPPROVED_SERVER_ACTION=

# Optional. A Discord webhook URL to post alerts to, as well as DMing the
# owners. Useful when you want the trail in a channel rather than a DM.
ALERT_WEBHOOK_URL=

# Optional. Set while developing: `npm run deploy` then registers the slash
# commands to this one server, where they appear instantly instead of taking up
# to an hour to propagate globally. Leave empty in production.
DISCORD_GUILD_ID=

# Optional. Where per-server settings are kept. Relative paths resolve from the
# working directory. Default: data/guilds.json
DATA_FILE=

# Optional. The tier's flask/food/potion data, read once at startup.
# Default: tiers/current.json
TIER_FILE=

# Optional, and free: create a client at https://develop.battle.net.
#
# Used for two things. `npm run sync-tier` fills item ids, craft yields and
# reagents into the tier file. The running bot uses them to price a shopping
# list off the region-wide commodity auction house — leave them empty and
# everything works exactly as before, minus the prices.
#
# Blizzard regenerates the auction data hourly at 20 minutes past, so prices are
# fetched at most once per refresh and cached until 25 past the next hour.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# eu | us | kr | tw. Default: eu
BLIZZARD_REGION=
# Default: en_GB
BLIZZARD_LOCALE=

# Optional. debug | info | warn | error. Default: info
LOG_LEVEL=

# Optional. What the bot calls itself in its own messages. Default: Sleepwalkers Quartermaster
BOT_NAME=

# Optional. The short form, used in every embed footer. Default: Quartermaster
BOT_SHORT_NAME=
