{
  "name": "herald",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for World of Warcraft raiding guilds: server setup, default rank on join, and a self-serve Social/Raider landing page.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "deploy": "node --env-file-if-exists=.env src/deploy-commands.js",
    "test": "node --test \"test/*.test.js\"",
    "sync-tier": "node --env-file-if-exists=.env scripts/sync-tier.js",
    "check-guides": "node scripts/check-guides.js",
    "import-tier": "node scripts/import-tier.js",
    "import-table": "node scripts/import-table.js",
    "invite": "node --env-file-if-exists=.env scripts/invite.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
